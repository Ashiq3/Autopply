# ==============================================================================
# AutoApply AI - Environment Configuration
# ==============================================================================
# Copy this file to `.env` before running locally:
#   cp .env.example .env
# ==============================================================================

# [REQUIRED FOR DEFAULT PROVIDER] Google Gemini API Key
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# [OPTIONAL] Gemini Model Name (defaults to high-quota free-tier gemini-3.1-flash-lite)
# GEMINI_MODEL="gemini-3.1-flash-lite"

# [OPTIONAL] OpenRouter API Key (https://openrouter.ai/keys)
# OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# [OPTIONAL] OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# [OPTIONAL] Anthropic (Claude) API Key (https://console.anthropic.com/)
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# [OPTIONAL] Default Server AI Provider ('gemini' | 'openrouter' | 'openai' | 'anthropic')
# AI_PROVIDER="gemini"

# [OPTIONAL] Server Port (defaults to 3000)
# PORT="3000"

# [OPTIONAL] Public URL where the app is hosted (for self-referential links)
APP_URL="http://localhost:3000"
