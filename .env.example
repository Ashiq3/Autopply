# ==============================================================================
# AutoApply AI - Environment Configuration
# ==============================================================================
# Copy this file to `.env` before running locally:
#   cp .env.example .env
#
# Note: Users can also connect any third-party AI provider directly from
# Settings -> AI Model Provider in the web UI without editing `.env`.
# ==============================================================================

# [OPTIONAL] Default Server AI Provider:
# 'openrouter' | 'openai' | 'anthropic' | 'groq' | 'deepseek' | 'together' | 'mistral' | 'custom'
AI_PROVIDER="openrouter"

# [OPTIONAL] OpenRouter API Key (supports free models like openrouter/free)
# https://openrouter.ai/keys
# OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# [OPTIONAL] OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# [OPTIONAL] Anthropic Claude API Key (https://console.anthropic.com/)
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# [OPTIONAL] Groq API Key (https://console.groq.com/keys)
# GROQ_API_KEY="YOUR_GROQ_API_KEY"

# [OPTIONAL] DeepSeek API Key (https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# [OPTIONAL] Together AI API Key (https://api.together.xyz/settings/api-keys)
# TOGETHER_API_KEY="YOUR_TOGETHER_API_KEY"

# [OPTIONAL] Mistral AI API Key (https://console.mistral.ai/api-keys/)
# MISTRAL_API_KEY="YOUR_MISTRAL_API_KEY"

# [OPTIONAL] Custom OpenAI-Compatible Endpoint (HTTPS only)
# CUSTOM_LLM_BASE_URL="https://api.x.ai/v1"
# CUSTOM_LLM_API_KEY="YOUR_CUSTOM_API_KEY"

# [OPTIONAL] Backend Rate & Daily Usage Caps on /api/agent/*
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX_PER_IP="12"
# MAX_DAILY_AI_REQUESTS="250"

# [OPTIONAL] Server Port (defaults to 3000)
# PORT="3000"

# [OPTIONAL] Public URL where the app is hosted
APP_URL="http://localhost:3000"
